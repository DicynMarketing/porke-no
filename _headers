# Cabeceras de seguridad (Cloudflare Pages).
# - Nadie puede meter la app dentro de otra página (evita engaños tipo "clickjacking").
# - Solo se cargan programas de los servicios que usa la app: Supabase, Sentry, PostHog, mapas y fuentes.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://browser.sentry-cdn.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://dgfdkcphklmeqlvyzmpu.supabase.co https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://cdnjs.cloudflare.com; media-src 'self' data: blob:; connect-src 'self' https://dgfdkcphklmeqlvyzmpu.supabase.co wss://dgfdkcphklmeqlvyzmpu.supabase.co https://*.ingest.us.sentry.io https://us.i.posthog.com https://us-assets.i.posthog.com; worker-src 'self'; manifest-src 'self'; frame-src 'self' blob: data:; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
